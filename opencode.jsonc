{
  "$schema": "https://opencode.ai/config.json",

  // Agente padrão: somente leitura. Alinhe com o agente Build quando precisar editar.
  "default_agent": "plan",

  // Compactação do contexto: resume mais cedo e mantém só o essencial recente.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000
    },
    "buffer": "20%"
  },

  // Trunca saídas longas de terminal antes de gastarem contexto.
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000
  },

  // Imagens menores no contexto.
  "media": {
    "image": {
      "auto_resize": true,
      "max_base64_bytes": 1048576
    }
  },

  // Ignora artefatos gerados na observação de arquivos.
  "watcher": {
    "ignore": ["node_modules/**", ".next/**", ".qa/**", "out/**", "coverage/**"]
  }
}
